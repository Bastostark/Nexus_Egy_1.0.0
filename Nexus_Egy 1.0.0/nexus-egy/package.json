{
  "name": "nexus-egy",
  "version": "1.0.0",
  "description": "Nexus Egy - Universal Gaming System",
  "main": "electron/main.js",
  "author": "Nexus Egy",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:mac": "electron-builder --mac dmg",
    "android:sync": "npx cap sync android",
    "postinstall": "node scripts/prepare.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@fontsource-variable/outfit": "^5.0.0",
    "@fontsource-variable/orbitron": "^5.0.0",
    "material-icons": "^1.13.12"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nexusegy.app",
    "productName": "Nexus Egy",
    "files": [
      "electron/**",
      "www/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}